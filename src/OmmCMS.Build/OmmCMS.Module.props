<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<Import Project="OmmCMS.Razor.props" />
	
	<PropertyGroup>
		<OutputType>Library</OutputType>
	</PropertyGroup>
	
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateProvideApplicationPartFactoryAttribute>true</GenerateProvideApplicationPartFactoryAttribute>
		<ProvideApplicationPartFactoryAttributeTypeName>OmmCMS.Engine.Modularity.ApplicationParts.ModuleRazorAssemblyPartFactory, OmmCMS</ProvideApplicationPartFactoryAttributeTypeName>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<PreserveCompilationReferences>false</PreserveCompilationReferences>
		<MvcRazorExcludeRefAssembliesFromPublish>true</MvcRazorExcludeRefAssembliesFromPublish>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
        <Content Include="module.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
		<Content Include="wwwroot\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Localization\*.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\**\*.cshtml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
        <ProjectReference Include="..\..\OmmCMS\OmmCMS.csproj">
            <Private>False</Private>
            <CopyLocal>False</CopyLocal>
            <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
        </ProjectReference>
		<ProjectReference Include="..\..\OmmCMS.Core\OmmCMS.Core.csproj">
			<Private>False</Private>
			<CopyLocal>False</CopyLocal>
			<CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
		</ProjectReference>
		<ProjectReference Include="..\..\OmmCMS.Web.Common\OmmCMS.Web.Common.csproj">
			<Private>False</Private>
			<CopyLocal>False</CopyLocal>
			<CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
		</ProjectReference>
	</ItemGroup>
	
	<ProjectExtensions>
		<VisualStudio>
			<UserProperties module_1json__JsonSchema="..\..\OmmCMS.Web\Properties\module.schema.json#" />
		</VisualStudio>
	</ProjectExtensions>
	
</Project>
