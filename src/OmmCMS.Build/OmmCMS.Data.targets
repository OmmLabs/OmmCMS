<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <BinDir>bin\$(Configuration)\</BinDir>
        <!-- RID builds must collect matching provider binaries, never a stale portable build. -->
        <BinDir Condition="'$(RuntimeIdentifier)' != '' And '$(AppendRuntimeIdentifierToOutputPath)' != 'false'">$(BinDir)$(RuntimeIdentifier)\</BinDir>
        <DataDir>..\OmmCMS.Data\</DataDir>
    </PropertyGroup>

    <!--
    Build data provider projects before the host without referencing their assemblies
    or flowing their NuGet packages into the host compile/runtime graph.
    -->
    <ItemGroup>
        <ProjectReference Include="$(DataDir)OmmCMS.Data.Sqlite\OmmCMS.Data.Sqlite.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          ExcludeAssets="all" />
        <ProjectReference Include="$(DataDir)OmmCMS.Data.SqlServer\OmmCMS.Data.SqlServer.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          ExcludeAssets="all" />
        <ProjectReference Include="$(DataDir)OmmCMS.Data.PostgreSql\OmmCMS.Data.PostgreSql.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          ExcludeAssets="all" />
        <ProjectReference Include="$(DataDir)OmmCMS.Data.MySql\OmmCMS.Data.MySql.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          ExcludeAssets="all" />
    </ItemGroup>

    <!-- Ensure Visual Studio's Fast Up-To-Date Check triggers a copy if provider binaries are missing or updated. -->
    <ItemGroup>
        <UpToDateCheckBuilt Include="$(OutDir)OmmCMS.Data.Sqlite.dll" Original="$(DataDir)OmmCMS.Data.Sqlite\$(BinDir)OmmCMS.Data.Sqlite.dll" />
        <UpToDateCheckBuilt Include="$(OutDir)OmmCMS.Data.SqlServer.dll" Original="$(DataDir)OmmCMS.Data.SqlServer\$(BinDir)OmmCMS.Data.SqlServer.dll" />
        <UpToDateCheckBuilt Include="$(OutDir)OmmCMS.Data.PostgreSql.dll" Original="$(DataDir)OmmCMS.Data.PostgreSql\$(BinDir)OmmCMS.Data.PostgreSql.dll" />
        <UpToDateCheckBuilt Include="$(OutDir)OmmCMS.Data.MySql.dll" Original="$(DataDir)OmmCMS.Data.MySql\$(BinDir)OmmCMS.Data.MySql.dll" />
    </ItemGroup>

    <!-- Collect provider outputs dynamically after provider projects have built (never at evaluation time). -->
    <Target Name="CollectDataProviderFiles">
        <ItemGroup>
            <DataProviderDistFiles Include="$(DataDir)OmmCMS.Data.*\$(BinDir)*" Exclude="**\*.json;**\*.pdb" Condition="'$(Configuration)' == 'Release'" />
            <DataProviderDistFiles Include="$(DataDir)OmmCMS.Data.*\$(BinDir)*" Exclude="**\*.json" Condition="'$(Configuration)' != 'Release'" />
        </ItemGroup>
    </Target>

    <Target Name="CopyDataProvidersToOutput" AfterTargets="Build" DependsOnTargets="CollectDataProviderFiles">
        <Copy SourceFiles="@(DataProviderDistFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <!--
    Because data provider projects are not compile-referenced, announce their compiled binaries
    to the publish pipeline.
    -->
    <Target Name="PublishDataProviders" AfterTargets="ComputeFilesToPublish" DependsOnTargets="CollectDataProviderFiles">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(DataProviderDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
