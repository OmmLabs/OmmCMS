@using OmmCMS.Admin.Models.Common

@using OmmCMS.Core.Security
@inject IPermissionService PagePermissions
@model StateProvinceModel

@{
    var canUpdate = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Country.Update);
    var canDelete = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Country.Delete);
    ViewBag.Title = T("Admin.Configuration.Countries.States.EditStateDetails").Value;
    Layout = "_AdminPopupLayout";
}

<form asp-action="StateEditPopup" id="state-regions" asp-route-btnId="@ViewBag.BtnId" asp-route-formId="@ViewBag.FormId">
    <div class="section-header">
        <div class="title">
            @ViewBag.Title
        </div>
        <div class="options">
            <button sm-if="canUpdate" type="submit" name="save" value="save" class="btn btn-primary">
                <icon name="check" />
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <partial name="_CreateOrUpdateState" model="Model" />
</form>

