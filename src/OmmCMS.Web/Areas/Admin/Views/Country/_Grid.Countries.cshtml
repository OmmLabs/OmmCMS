@using OmmCMS.Admin.Models.Common

@using OmmCMS.Core.Security
@inject IPermissionService PagePermissions
@model CountryModel

@{
    var canCreate = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Country.Create);
    var canUpdate = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Country.Update);
    var canDelete = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Country.Delete);
}

<datagrid id="countries-grid" allow-resize="true" allow-row-selection="@canDelete" allow-edit="@canUpdate" allow-column-reordering="true">
    <datasource read="@Url.Action("CountryList", "Country")"
                update="@Url.Action("CountryUpdate", "Country")"
                delete="@Url.Action("CountryDelete", "Country")" />
    <sorting enabled="true">
        <sort by="DisplayOrder" />
    </sorting>
    <paging position="Bottom" show-size-chooser="true" />
    <search-panel>
        <partial name="_Grid.Countries.Search" />
    </search-panel>
    <toolbar>
        <toolbar-group>
            <button datagrid-action="DataGridToolAction.ToggleSearchPanel" type="button" class="btn btn-plain btn-icon">
                <icon name="filter" />
            </button>
        </toolbar-group>
        <toolbar-group>
            <a sm-if="canCreate" asp-action="Create" class="btn btn-primary btn-flat no-anims mr-auto">
                <icon name="plus"  />
                <span>@T("Admin.Common.AddNew")...</span>
            </a>
            <button sm-if="canUpdate" datagrid-action="DataGridToolAction.SaveChanges" type="button" class="btn btn-primary no-anims btn-flat">
                <icon name="check" />
                <span>@T("Admin.Common.SaveChanges")</span>
            </button>
            <button sm-if="canUpdate" datagrid-action="DataGridToolAction.CancelEdit" type="button" class="btn btn-plain mr-auto">
                <span>@T("Common.Cancel")</span>
            </button>
        </toolbar-group>
        <zone name="datagrid_toolbar_alpha"></zone>
        <toolbar-group class="omega"></toolbar-group>
        <zone name="datagrid_toolbar_omega"></zone>
        <toolbar-group>
            <button sm-if="canDelete" datagrid-action="DataGridToolAction.DeleteSelectedRows" type="button" class="btn btn-danger no-anims btn-flat">
                <icon name="trash" />
                <span>@T("Admin.Common.Delete.Selected")</span>
            </button>
        </toolbar-group>
    </toolbar>
    <columns>
        <column for="Name" width="1fr" hideable="false">
            <display-template>
                <a :href="item.row.EditUrl" class="text-truncate">
                    {{ item.value }}
                </a>
            </display-template>
        </column>
        <column for="TwoLetterIsoCode" halign="center" />
        <column for="ThreeLetterIsoCode" halign="center" visible="false" />
        <column for="NumericIsoCode" halign="center" visible="false" />
        <column for="LimitedToStores" halign="center" readonly="true" />
        <column for="Published" halign="center" />
        <column for="DisplayOrder" halign="center" />
    </columns>
    <row-commands>
        <a datarow-action="DataRowAction.Custom" :href="item.row.EditUrl">@T("Common.Edit")</a>
        <a sm-if="canDelete" datarow-action="DataRowAction.Delete">@T("Common.Delete")</a>
    </row-commands>
</datagrid>
