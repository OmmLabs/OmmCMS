@using OmmCMS.Admin.Models.Stores

@using OmmCMS.Core.Security
@inject IPermissionService PagePermissions
@model StoreModel

@{
    var canUpdate = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Store.Update);
    var canDelete = await PagePermissions.AuthorizeAsync(Permissions.Configuration.Store.Delete);
    ViewBag.Title = T("Admin.Configuration.Stores.EditStoreDetails").Value;
}

<form method="post" asp-action="Edit">
    <div class="section-header">
        <div class="title">
            <a sm-backto asp-action="List"></a>
            <icon name="globe" />
            <span>@ViewBag.Title</span>
        </div>
        <div class="options">
            <button sm-if="canUpdate" type="submit" name="save" value="save" class="btn btn-primary">
                <icon name="check" />
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button type="submit" name="save" value="save-continue" class="btn btn-secondary">
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>
            <button sm-if="canDelete" type="submit" name="store-delete" id="store-delete" value="store-delete" class="btn btn-secondary btn-destructive">
                <icon name="trash" />
                <span>@T("Admin.Common.Delete")</span>
            </button>
            <confirm sm-if="canDelete" button-id="store-delete" />
        </div>
    </div>

    <partial name="_CreateOrUpdate" model="Model" />
</form>