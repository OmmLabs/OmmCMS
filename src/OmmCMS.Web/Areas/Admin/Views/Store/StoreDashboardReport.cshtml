@{
    var arr = new[]
    {
        new { Part = "TopicsCount", Label = T("Admin.ContentManagement.Topics").Value, Title = T("Admin.ContentManagement.Topics").Value, Icon = "file" },
        new { Part = "MenusCount", Label = T("Admin.ContentManagement.Menus").Value, Title = T("Admin.ContentManagement.Menus").Value, Icon = "nodes" },
        new { Part = "MediaCount", Label = T("Admin.Plugins.KnownGroup.Media").Value, Title = T("Admin.Plugins.KnownGroup.Media").Value, Icon = "images" },
        new { Part = "MediaSize", Label = T("Admin.Report.MediaFilesSize").Value, Title = T("Admin.Report.MediaFilesSize").Value, Icon = "hdd" },
        new { Part = "CustomersCount", Label = T("Admin.Customers.Customers").Value, Title = T("Admin.Customers.Reports.RegisteredCustomers").Value, Icon = "user-group" },
        new { Part = "OnlineCustomersCount", Label = T("Admin.Customers.OnlineCustomers").Value, Title = T("Admin.Report.OnlineCustomers").Value, Icon = "login" }
    };
}

<div class="report">
    <div class="report-title-row">
        <div class="report-title">@T("Admin.Report.StoreStatistics")</div>
    </div>
    <div class="statistics-container p-4 pb-5">
        <div class="row g-2">
            @for (var i = 0; i < arr.Length; i++)
            {
                <div class="col-6 col-md-4 col-xl-3 col-xxl-4 statistics-col">
                    <div class="statistics-content bg-secondary rounded py-2 px-3">
                        <div class="statistics-container-outer text-truncate">
                            <div class="statistics-container-inner text-truncate">
                                <div class="statistics-value text-truncate fwm" data-part="@arr[i].Part">
                                    <span class="placeholder-wave" style="color: var(--gray-600)">
                                        <span class="placeholder placeholder-xs" style="width: 40px"></span>
                                    </span>
                                </div>
                                <div class="statistics-attribute text-truncate" title="@arr[i].Title">@arr[i].Label</div>
                            </div>
                        </div>
                        <div class="statistics-icon">
                            <icon name="@arr[i].Icon" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script data-origin="DashboardStoreReport">
    $(function () {
        $.ajax({
            url: "@(Url.Action("StoreDashboardReport", "Store"))",
            type: "GET",
            cache: false,
            success: function (data) {
                var elements = $('.statistics-value');
                elements.each(function (i, element) {
                    var part = $(element).data('part');
                    $(element).html(data.model[part]);
                    $(element).attr('title', data.model[part]);
                });
            }
        });
    });
</script>
