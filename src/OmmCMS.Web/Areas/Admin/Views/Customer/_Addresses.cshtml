@using OmmCMS.Core.Security
@inject IPermissionService CustomerPermissions
@model CustomerModel.AddressesModel

@{
    var canEdit = await CustomerPermissions.AuthorizeAsync(Permissions.Customer.EditAddress);
    var canDelete = await CustomerPermissions.AuthorizeAsync(Permissions.Customer.DeleteAddress);
    var canRead = await CustomerPermissions.AuthorizeAsync(Permissions.Customer.ReadAddress);
}

<div class="grid gap-3">
    @foreach (var address in Model.Addresses)
    {
        <div class="card g-col-12 g-col-sm-6 g-col-md-4 g-col-xl-3">
            <div class="card-body">
                <div class="mb-2">
                    @Html.Raw(address.FormattedAddress)
                </div>
                <div sm-if="address.Email.HasValue()" class="email">
                    @T("Address.Fields.Email"): @address.Email
                </div>
                <div sm-if="address.PhoneNumber.HasValue()" class="phone">
                    @T("Address.Fields.PhoneNumber"): @address.PhoneNumber
                </div>
                <div sm-if="address.FaxNumber.HasValue()" class="fax">
                    @T("Address.Fields.FaxNumber"): @address.FaxNumber
                </div>
            </div>
            <div class="card-footer d-flex p-2">
                <a sm-if="canRead" asp-action="AddressEdit" asp-controller="Customer" asp-route-customerId="@Model.Id" asp-route-addressId="@address.Id"
                    class="btn btn-sm btn-flat btn-icon btn-secondary"
                    title="@T("Common.Edit")">
                    <icon name="edit"  />
                </a>
                <button sm-if="canDelete" id="address-delete-@address.Id" type="button" class="btn btn-sm btn-flat btn-icon btn-danger ml-1 delete-address"
                        title="@T("Common.Delete")"
                        data-url="@Url.Action("AddressDelete", "Customer", new { customerId = Model.Id, addressId = address.Id })">
                    <icon name="trash" />
                </button>

                <div sm-if="address.DefaultAddressesEnabled" class="ml-auto d-flex">
                    @if (address.IsDefaultAddress)
                    {
                        <span class="badge badge-success align-self-center p-1 pr-2">
                            <icon name="check" class="mx-1" />
                            <span>@T("Address.IsDefaultAddress")</span>
                        </span>
                    }
                    else
                    {
                        <button sm-if="canEdit" type="button" class="btn btn-light btn-flat btn-sm default-address-button"
                                data-url="@Url.Action("SetDefaultAddress", "Customer", new { customerId = Model.Id, addressId = address.Id })"
                                title="@T("Common.SetDefault")">
                            <span>@T("Common.SetDefault")</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>
