@using OmmCMS.Core.Security
@inject IPermissionService CustomerPermissions
@model CustomerModel

@{
    var canUpdate = await CustomerPermissions.AuthorizeAsync(Permissions.Customer.Update);
    var canDelete = await CustomerPermissions.AuthorizeAsync(Permissions.Customer.Delete);
    var canSend = await CustomerPermissions.AuthorizeAsync(Permissions.System.Message.Send);
    ViewBag.Title = T("Admin.Customers.Customers.EditCustomerDetails").Value;
}

<form method="post" asp-action="Edit" id="customer-form" attr-novalidate='(Model.IsGuest, "novalidate")'>
    <div class="section-header">
        <div class="title">
            <a sm-backto asp-action="List"></a>
            <icon name="user-edit" />
            <span>@ViewBag.Title - @(Model.FullName.NullEmpty() ?? (Model.IsGuest ? T("Admin.Customers.Guest") : string.Empty))</span>
        </div>
        <div class="options">
            <zone name="admin_button_toolbar_before" />

            <a sm-if="Model.DisplayProfileLink" asp-route="CustomerProfile" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="user-profile">
                <icon name="external-link" />
                <span>@T("Common.UserProfile")</span>
            </a>

            @if (canSend && await Display.ZoneHasWidgetsAsync("admin_button_toolbar_messaging_dropdown"))
            {
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-toggle="dropdown">
                        <icon name="mail" />
                        <span>@T("Common.Send")</span>
                    </button>
                    <div class="dropdown-menu">
                        <a href="#sendemail-window" data-toggle="modal" class="dropdown-item">@T("Admin.Customers.Customers.SendEmail")</a>
                        <zone name="admin_button_toolbar_messaging_dropdown" />
                    </div>
                </div>
            }
            else if (canSend)
            {
                <a href="#sendemail-window" data-toggle="modal" class="btn btn-outline-secondary">
                    <icon name="send" />
                    <span>@T("Admin.Customers.Customers.SendEmail")</span>
                </a>
            }

            <a asp-action="Export" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <icon name="upload" />
                <span>@T("Common.Export")</span>
            </a>

            <span class="vr"></span>

            <button sm-if="canUpdate" type="submit" name="save" value="save" class="btn btn-primary" attr-formnovalidate='(Model.IsGuest, "formnovalidate")'>
                <icon name="check" />
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button type="submit" name="save" value="save-continue" class="btn btn-secondary" attr-formnovalidate='(Model.IsGuest, "formnovalidate")'>
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>

            <button sm-if="canDelete && !Model.Deleted" type="button" id="delete-customer" class="btn btn-secondary btn-destructive">
                <icon name="trash" />
                <span>@T("Admin.Customers.DeleteCustomer")</span>
            </button>

            <zone name="admin_button_toolbar_after" />
        </div>
    </div>

    <partial name="_CreateOrUpdate" model="Model" />
</form>

<partial sm-if="canSend" name="_SendEmailWindow" model="new CustomerModel.SendEmailModel { CustomerId = Model.Id }" />

@if (Model.Id != 0)
{
    <partial sm-if="canUpdate" name="_ChangePasswordPopup" model="new CustomerModel.ChangePasswordModel { Id = Model.Id }" />

    if (Model.CookieConsent != null)
    {
        <partial name="_CookieConsentPopup" model="Model.CookieConsent" />
    }
}