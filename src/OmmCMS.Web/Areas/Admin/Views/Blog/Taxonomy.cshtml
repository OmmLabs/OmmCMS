@using OmmCMS.Admin.Models.Blogs
@model List<BlogTermEditModel>
@{
    var isTag = (bool)ViewBag.IsTag;
    ViewBag.Title = isTag ? "Blog tags" : "Blog categories";
}
<div class="section-header">
    <div class="title">@ViewBag.Title</div>
    <div class="options">
        <a asp-action="Term" asp-route-isTag="@isTag" class="btn btn-primary">New @(isTag ? "tag" : "category")</a>
        <a asp-action="List" class="btn btn-secondary">Blog posts</a>
        <a asp-action="Taxonomy" asp-route-isTag="@(!isTag)" class="btn btn-secondary">@(isTag ? "Categories" : "Tags")</a>
    </div>
</div>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>URL slug</th><th>Description</th><th></th></tr></thead>
    <tbody>
    @foreach (var term in Model)
    {
        <tr><td><a asp-action="Term" asp-route-id="@term.Id" asp-route-isTag="@isTag">@term.Name</a></td><td>@term.Slug</td><td>@term.Description</td>
        <td><a asp-action="Term" asp-route-id="@term.Id" asp-route-isTag="@isTag" class="btn btn-sm btn-secondary">Edit</a></td></tr>
    }
    </tbody>
</table>
@if (Model.Count == 0) { <p>No entries yet.</p> }
