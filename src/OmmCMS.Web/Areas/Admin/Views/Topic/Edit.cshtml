@using OmmCMS.Admin.Models.Topics

@using OmmCMS.Core.Security
@inject IPermissionService TopicPermissions
@model TopicModel

@{
    var canUpdate = await TopicPermissions.AuthorizeAsync(Permissions.Cms.Topic.Update);
    var canDelete = !Model.IsSystemTopic && await TopicPermissions.AuthorizeAsync(Permissions.Cms.Topic.Delete);
    ViewBag.Title = T("Admin.ContentManagement.Topics.EditTopicDetails") + " - " + @Model.SystemName;
}

<form id="topic-form" asp-action="Edit">
    <div class="section-header">
        <div class="title">
            <a sm-backto asp-action="List"></a>
            <icon name="file" />
            <span>@ViewBag.Title</span>
        </div>
        <div class="options">
            <button sm-if="canUpdate" type="submit" name="save" value="save" class="btn btn-primary">
                <icon name="check" />
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button sm-if="canUpdate" type="submit" name="save" value="save-continue" class="btn btn-secondary">
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>
            <button sm-if="canDelete" type="submit" name="topic-delete" value="topic-delete" id="topic-delete" class="btn btn-secondary btn-destructive">
                <icon name="trash" />
                <span>@T("Admin.Common.Delete")</span>
            </button>
            <confirm sm-if="canDelete" button-id="topic-delete" />
        </div>
    </div>

    <partial name="_CreateOrUpdate" />
</form>
