@using OmmCMS.Admin.Models.Menus
@using OmmCMS.Core.Security
@inject IPermissionService MenuPermissions

@model MenuItemModel

@{
    var canUpdate = await MenuPermissions.AuthorizeAsync(Permissions.Cms.Menu.Update);
    var canDelete = await MenuPermissions.AuthorizeAsync(Permissions.Cms.Menu.Delete);
    ViewBag.Title = T("Admin.ContentManagement.EditMenuItem").Value;
}

<form method="post" asp-action="EditItem">
    <div class="section-header">
        <div class="title">
            <a sm-backto asp-action="Edit" asp-route-id="@Model.MenuId" title="@T("Common.Back")"></a>
            <span>@T("Admin.ContentManagement.EditMenuItem") - @(Model.Title.NullEmpty() ?? Model.TitlePlaceholder)</span>
        </div>
        <div class="options">
            <button sm-if="canUpdate" type="submit" name="save-item" value="save-item" class="btn btn-primary">
                <icon name="check" />
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button sm-if="canUpdate" type="submit" name="save-item-continue" value="save-item-continue" class="btn btn-secondary">
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>
            <button sm-if="canDelete" type="submit" name="delete-item" value="delete-item" id="delete-item" class="btn btn-secondary btn-destructive">
                <icon name="trash" />
                <span>@T("Admin.Common.Delete")</span>
            </button>
            <confirm sm-if="canDelete" button-id="delete-item" action="DeleteItem" />
        </div>
    </div>

    <partial name="_CreateOrUpdate.Item" model="Model" />
</form>