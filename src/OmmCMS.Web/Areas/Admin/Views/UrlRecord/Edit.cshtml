@using OmmCMS.Admin.Models.UrlRecord

@using OmmCMS.Core.Security
@inject IPermissionService UrlPermissions
@model UrlRecordModel

@{
    var canUpdate = await UrlPermissions.AuthorizeAsync(Permissions.System.UrlRecord.Update);
    var canDelete = await UrlPermissions.AuthorizeAsync(Permissions.System.UrlRecord.Delete);
    ViewBag.Title = T("Admin.Common.Edit") + " - " + Model.Slug;
}

<form asp-action="Edit">
    <div class="section-header">
        <div class="title">
            <a sm-backto asp-action="List"></a>
            <icon name="search" />
            <span>@ViewBag.Title</span>
        </div>
        <div class="options">
            <a sm-if="!string.IsNullOrEmpty(Model.EntityUrl)" href="@Model.EntityUrl" class="btn btn-secondary">
                <icon name="external-link" />
                <span>@T("Admin.Common.Entity")</span>
            </a>
            <button sm-if="canUpdate" type="submit" name="save" value="save" class="btn btn-primary">
                <icon name="check" />
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button sm-if="canUpdate" type="submit" name="save" value="save-continue" class="btn btn-secondary">
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>
            <button sm-if="canDelete" type="submit" id="urlrecord-delete" name="urlrecord-delete" class="btn btn-secondary btn-destructive">
                <icon name="trash" />
                <span>@T("Admin.Common.Delete")</span>
            </button>
            <confirm sm-if="canDelete" button-id="urlrecord-delete" />
        </div>
    </div>

    <partial name="_CreateOrUpdate" />
</form>
