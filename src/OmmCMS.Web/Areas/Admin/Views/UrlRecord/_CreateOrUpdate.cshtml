@using OmmCMS.Admin.Models.UrlRecord

@using OmmCMS.Core.Security
@inject IPermissionService UrlPermissions
@model UrlRecordModel

@{
    var canUpdate = await UrlPermissions.AuthorizeAsync(Permissions.System.UrlRecord.Update);
}

<div asp-validation-summary="All"></div>

<div class="adminContent">
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="Id" />
        </div>
        <div class="adminData">
            <input asp-for="Id" readonly />
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="IsActive" />
        </div>
        <div class="adminData">
            <input asp-for="IsActive" disabled="@(!canUpdate)" />
            <span asp-validation-for="IsActive"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="LanguageId" />
        </div>
        <div class="adminData">
            <select asp-for="LanguageId" asp-items="ViewBag.AvailableLanguages" disabled="@(!canUpdate)"></select>
            <span asp-validation-for="LanguageId"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="EntityName" />
        </div>
        <div class="adminData">
            <input asp-for="EntityName" readonly />
            <span asp-validation-for="EntityName"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="EntityId" />
        </div>
        <div class="adminData">
            <input asp-for="EntityId" readonly />
            <span asp-validation-for="EntityId"></span>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            <smart-label asp-for="Slug" />
        </div>
        <div class="adminData">
            <input asp-for="Slug" readonly="@(!canUpdate)" />
            <span asp-validation-for="Slug"></span>
            @await Component.InvokeAsync("NamesPerEntity", new { entityName = Model.EntityName, entityId = Model.EntityId })
        </div>
    </div>
</div>
