<Project Sdk="Microsoft.NET.Sdk.Web">

	<Import Project="..\OmmCMS.Build\OmmCMS.Common.props" />
	<Import Project="..\OmmCMS.Build\OmmCMS.Razor.props" />
    <Import Project="..\OmmCMS.Build\OmmCMS.Data.targets" />

	<PropertyGroup>
		<UserSecretsId>b35c0f56-dfa8-4120-b29b-a677578afcd1</UserSecretsId>
		<CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
		<RuntimeIdentifiers>win-x64; linux-x64; linux-arm64; osx-x64</RuntimeIdentifiers>
        <ProvideApplicationPartFactoryAttributeTypeName>OmmCMS.Engine.Modularity.ApplicationParts.HostRazorAssemblyPartFactory, OmmCMS</ProvideApplicationPartFactoryAttributeTypeName>
		<!--<PublishReadyToRun>true</PublishReadyToRun>-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Razor" Version="6.0.36" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" Version="6.0.36" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="Smartstore.LightningCss.Native" Version="1.33.0.1" />
		<PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
	</ItemGroup>

	<ItemGroup> 
		<ProjectReference Include="..\OmmCMS\OmmCMS.csproj" />
		<ProjectReference Include="..\OmmCMS.Core\OmmCMS.Core.csproj" />
		<ProjectReference Include="..\OmmCMS.Web.Common\OmmCMS.Web.Common.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<Compile Remove="App_Data\**; Modules\**; Themes\**" />
		<Content Remove="App_Data\**; Modules\**; Themes\**" />
		<EmbeddedResource Remove="App_Data\**; Modules\**; Themes\**" />
		<None Remove="App_Data\**; Modules\**; Themes\**" />
	</ItemGroup>
	
	<!-- Copy publishable files in App_Data directory -->
	<ItemGroup>
		<None Include="App_Data\widgetzones.json" CopyToPublishDirectory="PreserveNewest" />
		<None Include="App_Data\dashboard.*.json" CopyToPublishDirectory="PreserveNewest" />
		<None Include="App_Data\EmailTemplates\**" CopyToPublishDirectory="PreserveNewest" />
		<None Include="App_Data\Geo\**" CopyToPublishDirectory="PreserveNewest" />
		<!-- Licensed Pro assets are local-only and must not enter publish/deployment output. -->
		<None Include="App_Data\Icons\**" Exclude="App_Data\Icons\fontawesome-pro\**" CopyToPublishDirectory="PreserveNewest" />
		<None Include="App_Data\Seed\**" Exclude="App_Data\Seed\README.md" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Copy publishable files in Areas directory -->
	<ItemGroup>
		<Content Include="Areas\Admin\ommcms-sitemap.xml" CopyToPublishDirectory="PreserveNewest" />
		<None Include="Areas\Admin\Views\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Copy publishable files in Modules directory -->
	<ItemGroup>
        <None Include="Modules\**" Exclude="Modules\**\*.pdb; Modules\**\runtimes\**; Modules\**\refs\**" CopyToPublishDirectory="PreserveNewest">
            <Visible>false</Visible>
        </None>
	</ItemGroup>

	<!-- Copy publishable files in Themes directory -->
	<ItemGroup>
        <Content CopyToPublishDirectory="PreserveNewest" Exclude="Themes\*\Views\**\*.cshtml" Include="Themes\Flex\**; Themes\FlexBlack\**; Themes\FlexBlue\**" />
        <None CopyToPublishDirectory="PreserveNewest" Include="Themes\Flex\Views\**\*.cshtml; Themes\FlexBlack\Views\**\*.cshtml; Themes\FlexBlue\Views\**\*.cshtml" />	
    </ItemGroup>

	<!-- Copy publishable files in Views directory -->
	<ItemGroup>
		<None Include="Views\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
    
    <!-- Don't publish static/raw files -->
	<ItemGroup>
        <Content Remove="wwwroot\exchange\**" CopyToPublishDirectory="Never" />
        <Content Remove="wwwroot\.well-known\**" CopyToPublishDirectory="Never" />
        <Content Remove="wwwroot\css\compiled\**" CopyToPublishDirectory="Never" />
        <!-- Don't publish README files in wwwroot -->
        <None Include="wwwroot\**\README.md" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<Content Update="Config\usersettings.Development.json" CopyToPublishDirectory="Never">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<Content Update="Config\usersettings.json" CopyToPublishDirectory="PreserveNewest">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

    <ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>OmmCMS.Web.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

    <PropertyGroup>
        <AssemblyName>OmmCMS.Web</AssemblyName>

        <!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your project-->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
      
		<!-- More details about GC: https://docs.microsoft.com/en-us/dotnet/standard/garbage-collection/fundamentals -->
		<!--<ServerGarbageCollection>true</ServerGarbageCollection>-->
      
		<!-- More details here: https://docs.microsoft.com/en-us/dotnet/standard/garbage-collection/fundamentals#concurrent-garbage-collection -->
		<!--<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>-->
	</PropertyGroup>

    <!-- Exclude mobile and browser-wasm native libraries from server builds and publish output. -->
    <Target Name="PruneNonServerRuntimes" AfterTargets="ResolvePackageAssets" Condition="'$(RuntimeIdentifier)' == ''">
        <ItemGroup>
            <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                Condition="$([System.String]::new('%(RuntimeIdentifier)').StartsWith('android', StringComparison.OrdinalIgnoreCase)) Or
                           $([System.String]::new('%(RuntimeIdentifier)').StartsWith('ios', StringComparison.OrdinalIgnoreCase)) Or
                           $([System.String]::new('%(RuntimeIdentifier)').StartsWith('maccatalyst', StringComparison.OrdinalIgnoreCase)) Or
                           $([System.String]::new('%(RuntimeIdentifier)').StartsWith('browser-wasm', StringComparison.OrdinalIgnoreCase))" />
        </ItemGroup>
    </Target>

</Project>
