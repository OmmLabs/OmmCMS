<p class="text-center">{{ Store.Copyright }}</p>

{% assign company = Store.Company %}
{% assign contact = Store.Contact %}

<table class="w-100">
	<tbody>
		<tr>
			<td width="50%">
				<p class="text-xs text-muted">
					{% if company.CompanyName %}{{ company.CompanyName }}{% endif %}
					{% if company.NameLine %}<br/>{{ company.NameLine | Join }}{% endif %}
					{% if company.Street %}<br/>{{ company.Street }}{% endif %}
					{% if company.Street2 %}<br/>{{ company.Street2 }}{% endif %}
					{% if company.CityLine %}<br/>{{ company.CityLine | Join }}{% endif %}
					{% if company.CountryLine %}<br/>{{ company.CountryLine | Join:', ' }}{% endif %}
				</p>
			</td>
			<td width="50%">
				<p class="text-xs text-muted">
					<a href="{{ Store.Url }}">{{ Store.Url }}</a>
					{% if contact.Email.Company %}<br/>{{ 'Common.Company.Email' | T:contact.Email.Company }}{% endif %}
					{% if contact.Phone.Company %}<br/>{{ 'Common.Company.Phone' | T:contact.Phone.Company }}{% endif %}
					{% if contact.Phone.Fax %}<br/>{{ 'Common.Company.Fax' | T:contact.Phone.Fax }}{% endif %}
					
					{% if company.TaxNumber %}<br/>{{ 'Common.Company.TaxNumber' | T }}&nbsp;{{ company.TaxNumber }}{% endif %}
					{% if company.VatId %}<br/>{{ 'Common.Company.VatId' | T }}&nbsp;{{ company.VatId }}{% endif %}
					{% if company.CommercialRegister %}<br/>{{ 'Common.Company.CommercialRegister' | T }}&nbsp;{{ company.CommercialRegister }}{% endif %}
				</p>
			</td>
		</tr>
	</tbody>
</table>
